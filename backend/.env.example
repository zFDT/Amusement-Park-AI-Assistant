ANTHROPIC_API_KEY=sk-ant-your-key-here
DATABASE_URL=postgresql+asyncpg://youyuan:youyuan@localhost:5432/youyuan
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=["http://localhost:5173"]
AI_DEBUG_LOGGING=false

# 可选：内测码模式的预置 AI 配置数组（JSON）
# 替换 sk-xxx 为你自己的 API Key
# AI_INTERNAL_PROFILES=[{"code":"vip666","api_mode":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-xxx","model_id":"gpt-4.1-mini"}]
AI_INTERNAL_PROFILES=[]
AI_DISTILL_PROFILE_CODE=
